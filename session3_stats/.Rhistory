knitr::opts_chunk$set(echo = TRUE)
BioVar_all_SC18 <- read_tsv("BioVar_all_SC18.txt")
library(tidyverse)
library(ggpubr)
BioVar_all_SC18 <- read_tsv("BioVar_all_SC18.txt")
BioVar_all_25sd_gain_arp6_SC18 <- read_tsv("BioVar_all_25sd_gain_arp6_SC18.txt") %>%
mutate(type="gain_arp6_SC18") %>%
select(Gene, type)
BioVar_all_25sd_loss_arp6_SC18 <- read_tsv("BioVar_all_25sd_loss_arp6_SC18.txt") %>%
mutate(type="loss_arp6_SC18")%>%
select(Gene, type)
BioVar_all_25sd_loss_gain_arp6_SC18 <- bind_rows(BioVar_all_25sd_gain_arp6_SC18, BioVar_all_25sd_loss_arp6_SC18)
colors_SC18 <- inner_join(BioVar_all_SC18, BioVar_all_25sd_loss_gain_arp6_SC18, by="Gene")
BioVar_all_SC18 %>%
ggplot(aes(x=WT_HTSeq_BioVar_SC18, y=arp6_HTSeq_BioVar_SC18)) +
geom_point() +
geom_point(data = colors_SC18, aes(col=type))
BioVar_all_SC53_1mM <- read_tsv("Biovar_WT_arp6_all_SC53.txt")
BioVar_all_SC53_1mM
BioVar_all_SC53_1mM
BioVar_all_SC53_1mM <- read_tsv("Biovar_WT_arp6_all_SC53.txt")
BioVar_all_25sd_gain_arp6_SC53_mapping2_MS <- read_tsv("BioVar_all_25sd_gain_arp6_SC53_mapping2_MS.txt") %>%
mutate(type="gain_arp6_SC53") %>%
select(Gene, type)
BioVar_all_25sd_loss_arp6_SC53_mapping2_MS <- read_tsv("BioVar_all_25sd_loss_arp6_SC53_mapping2_MS.txt") %>%
mutate(type="loss_arp6_SC53")%>%
select(Gene, type)
BioVar_all_25sd_loss_gain_arp6_SC53_mapping2_MS <- bind_rows(BioVar_all_25sd_gain_arp6_SC53_mapping2_MS, BioVar_all_25sd_loss_arp6_SC53_mapping2_MS)
colors_SC53 <- inner_join(BioVar_all_SC53_1mM, BioVar_all_25sd_loss_gain_arp6_SC53_mapping2_MS, by="Gene")
BioVar_all_SC53_1mM %>%
ggplot(aes(x=BioVar_WT_SC53, y=BioVar_arp6_SC53)) +
geom_point() +
geom_point(data = colors_SC53, aes(col=type))
