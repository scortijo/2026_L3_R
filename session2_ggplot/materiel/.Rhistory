library(tidyverse)
library(ggpubr)
mydata <- read_tsv("AverageIntensityCycle91_92_RootLengthForRanalysis.txt")
View(mydata)
mydata
mydata <- read_tsv("AverageIntensityCycle91_92_RootLengthForRanalysis.txt")
mydata
mydata <- read_tsv("AverageIntensityCycle91_92_RootLengthForRanalysis.txt") %>%
mutate(norm_density=Integrated_Density/Root_length)
mydata
ggplot(mydata, aes(x=norm_density)) +
geom_density()+
facet_grid(.~Replicate)
mydata
mutate(mydata, group=case_when(norm_density<250 ~ "low_signal",
norm_density>750 ~ "high_signal"))
mutate(mydata, group=case_when(norm_density<250 ~ "low_signal",
norm_density>750 ~ "high_signal")) %>%
group_by(group) %>%
summarise(n(state))
mutate(mydata, group=case_when(norm_density<250 ~ "low_signal",
norm_density>750 ~ "high_signal")) %>%
group_by(group, state) %>%
summarise(n())
ggplot(mydata, aes(x=norm_density)) +
geom_density()+
facet_grid(.~Replicate)
mutate(mydata, group=case_when(norm_density<250 ~ "low_signal",
norm_density>500 ~ "high_signal")) %>%
group_by(group, state) %>%
summarise(n())
