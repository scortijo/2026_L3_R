SC80
column_to_rownames(SC80,var =  info)
column_to_rownames(SC80,var = "info")
column_to_rownames(SC80,var = "info") %>% t()
column_to_rownames(SC80,var = "info") %>% t() %>% as.data.frame()
column_to_rownames(SC80,var = "info") %>% t() %>% as.data.frame() %>%  rownames_to_column(var="Area_nb")
SC80 <- read_tsv(file = "SC80_Allplates.txt")  %>% column_to_rownames(var = "info") %>% t() %>% as.data.frame() %>%  rownames_to_column(var="Area_nb")
SC80
ggplot(SC80, aes(x=genotype, y=Size_mm2, col=plate)) +
geom_boxplot()
SC80 <- read_tsv(file = "SC80_Allplates.txt")  %>% column_to_rownames(var = "info") %>% t() %>% as.data.frame() %>%  rownames_to_column(var="Area_nb") %>%
mutate(Size_mm2=as.numeric(Size_mm2))
SC80
ggplot(SC80, aes(x=genotype, y=Size_mm2, col=plate)) +
geom_boxplot()
SC80 <- read_tsv(file = "SC80_Allplates.txt")  %>% column_to_rownames(var = "info") %>% t() %>% as.data.frame() %>%  rownames_to_column(var="Area_nb") %>%
mutate(Size_mm2=as.numeric(Size_mm2),
Fv_Fm=as.numeric(Fv_Fm))
filter(SC80,plate!="plate1")
filter(SC80,plate!="plate1") %>%
group_by(genotype, plate) %>%
summarise(CV=sd(Size_mm2)/mean(Size_mm2))
filter(SC80,plate!="plate1") %>%
group_by(genotype) %>%
summarise(CV=sd(Size_mm2)/mean(Size_mm2))
SC80
ggplot(SC80, aes(x=genotype, y=Fv_Fm, col=plate)) +
geom_boxplot()
filter(SC80,plate!="plate1") %>%
group_by(genotype) %>%
summarise(CV=sd(Fv_Fm)/mean(Fv_Fm))
filter(SC80,plate!="plate1") %>%
ggplot(aes(x=genotype, y=Fv_Fm)) %>%
geom_boxplot()
filter(SC80,plate!="plate1") %>%
ggplot(aes(x=genotype, y=Fv_Fm)) +
geom_boxplot()
library(ggpubr)
filter(SC80,plate!="plate1") %>%
ggplot(aes(x=genotype, y=Fv_Fm)) +
geom_boxplot() +
stat_compare_means()
filter(SC80,plate!="plate1") %>%
ggplot(aes(x=genotype, y=Fv_Fm)) +
geom_boxplot() +
stat_compare_means(label.x = 1)
filter(SC80,plate!="plate1") %>%
ggplot(aes(x=genotype, y=Fv_Fm)) +
geom_boxplot() +
stat_compare_means(label.x = 1.5)
filter(SC80,plate!="plate1") %>%
ggplot(aes(x=genotype, y=Fv_Fm)) +
geom_boxplot() +
