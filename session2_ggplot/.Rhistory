library(ggpubr)
#Charger la librairie
library(tidyverse)
nitrate_data <- read_tsv("../2024_L3_R/session2_intro_ggplot/data/Cheng_2021_Arabidopsis_N.txt")
#Exercice 3
mutate(nitrate_data, AppliedN_g=AppliedN_mg*0.001) %>%
mutate(NUE=DryWeight_g/AppliedN_g) %>%
filter(Rep=="one") %>%
ggplot(aes(x=Accession , y=NUE, fill=Nlevel))+
geom_boxplot()+
stat_compare_means(label="p.signif")
NUE_data <- mutate(nitrate_data, AppliedN_g=AppliedN_mg*0.001) %>%
mutate(NUE=DryWeight_g/AppliedN_g) %>%
filter(Rep=="one" & Nlevel=="H")
NUE_data %>%
group_by(Accession) %>%
summarise(n.obs=n()) %>%
inner_join(NUE_data, by="Accession") %>%
ggplot(aes(x=Accession, y=NUE))+
geom_boxplot()+
geom_text(aes(label=n.obs, y=0))
ggplot(nitrate_data, aes(x = Accession, y=DryWeight_g, fill=Nlevel))+
geom_boxplot()+
stat_compare_means(label="p.signif", method="t.test")
#Ex3
nitrate_data %>%
mutate(AppliedN_g = AppliedN_mg / 1000, NUE = DryWeight_g / AppliedN_g) %>%
filter(Rep == "one") %>%
ggplot(aes(x = Accession, y = NUE, fill = Nlevel)) + geom_boxplot() + stat_compare_means(label="p.signif")
NUE_data %>%
group_by(Accession) %>%
summarise(nb_obs=n(), na.rm=TRUE) %>%
mutate(nb_obs = paste("n =", nb_obs)) %>%
inner_join(NUE_data, by="Accession") %>%
ggplot(aes(x=Accession, y=NUE)) + geom_boxplot() + geom_text(aes(label=nb_obs, x=Accession, y=0))
ggplot(nitrate_date,aes(x=Accession,y=DryWeight_g,color=Nlevel))+geom_boxplot()+stat_compare_means(label = "p.signif")
nitrate_date <- nitrate_data
ggplot(nitrate_date,aes(x=Accession,y=DryWeight_g,color=Nlevel))+geom_boxplot()+stat_compare_means(label = "p.signif")
nitrate_data %>%
mutate(AppliedN_g=AppliedN_mg/1000,NUE=DryWeight_g/AppliedN_g) %>%
filter(Rep=="one") %>%
ggplot(aes(x=NUE,y=Accession,color=Nlevel))+geom_boxplot()
NUE_data %>%
group_by(Accession) %>%
summarise(n.obs=n()) %>%
mutate(n.obs=paste("n =",n.obs)) %>%
inner_join(NUE_data,by="Accession") %>%
ggplot(aes(x=Accession,y=NUE))+
geom_boxplot()+
geom_text(aes(label=n.obs, x=Accession, y=0))
ggplot(nitrate_data, aes(x=Accession, y=DryWeight_g, fill=Nlevel)) +
geom_boxplot() +
stat_compare_means(label = "p.signif")
