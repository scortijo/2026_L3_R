geom_boxplot()+
stat_compare_means(label = "p.signif")
nitrate_data
mutate(nitrate_data, AppliedN_g = AppliedN_mg/1000) %>%
mutate(NUE = DryWeight_g/AppliedN_g) %>%
filter(Rep == "one") %>%
ggplot(aes(x = Accession, y = NUE, fill = Nlevel)) +
geom_boxplot()
NUE_data = mutate(nitrate_data, AppliedN_g = AppliedN_mg/1000) %>%
mutate(NUE = DryWeight_g/AppliedN_g) %>%
filter (Rep == "one") %>%
filter (Nlevel == "H")
group_by(NUE_data, Accession) %>%
summarise(n.obs = n()) %>%
mutate(n.obs = paste("n =",n.obs)) %>%
inner_join(NUE_data, by="Accession")%>%
ggplot(aes(x = Accession, y = NUE)) +
geom_boxplot() +
geom_text(aes(label=n.obs, x=Accession, y=-2),position=position_dodge(0.8), angle=45)
#Chargez le package tidyverse      ## 1/1 ##
library("tidyverse")
#Ajoutez au boxplot le résultat d’un test de comparaison de
# moyennes entre les deux niveaux d’azote pour chacune des accessions
library("ggpubr")
setwd("/Users/sandra2/Desktop/IPSiM/Teaching/2025-2026/L3_R/2025_L3_R/session2_ggplot/")
nitrate_data <- read_tsv("data/Cheng_2021_Arabidopsis_N.txt")
#Effectuez un boxplot du poids des plantes (DryWeight_g, axe y),
# en fonction de l’Accession (axe x), avec l’intérieur des boxplot colorés
# en fonction de du type de traitement d’azote (Nlevel`)
ggplot(nitrate_data, aes(Accession, DryWeight_g)) + geom_boxplot(aes(fill = Nlevel))
ggplot(nitrate_data, aes(Accession, DryWeight_g)) +
geom_boxplot(aes(fill = Nlevel)) +
stat_compare_means(label = "p.signif", method="t.test")
ggplot(nitrate_data, aes(x=Accession, y=DryWeight_g, fill=Nlevel)) + geom_boxplot()
# On veut réaliser un test statistique pour chacune des accessions en comparant les moyennes entre les deux groupes constituant chaque accession, un groupe traité avec une forte concentration en azote et l'autre avec une concentration faible.
# On définit l'hypothèse nulle: l'absence d'effet statistiquement significatif du niveau d'azote appliqué aux plantes sur leur poids, c'est-à-dire une égalité des moyennes des deux groupes comparés.
ggplot(nitrate_data, aes(Accession, DryWeight_g, fill=Nlevel)) +
geom_boxplot() + stat_compare_means(label="p.signif", method="t.test")
p1<-ggplot(nitrate_data,aes(x= Accession,y= DryWeight_g, fill=Nlevel)) + geom_boxplot(aes(alpha=0.5)) +
stat_compare_means(label="p.signif", method="t.test") + labs(title = "Poids des plantes en fonction de l'accesion")
ggplotly(p1)
#Réalisation d'un box plot
library(plotly)
p1<-ggplot(nitrate_data,aes(x= Accession,y= DryWeight_g, fill=Nlevel)) + geom_boxplot(aes(alpha=0.5)) +
stat_compare_means(label="p.signif", method="t.test") + labs(title = "Poids des plantes en fonction de l'accesion")
ggplotly(p1)
ggplot(nitrate_data, aes(x = Accession, y = DryWeight_g))+
geom_boxplot(aes(fill=Nlevel))
ggplot(nitrate_data, aes(x = Nlevel, y = DryWeight_g, fill = Nlevel)) +
geom_boxplot() +
stat_compare_means(label = "p.signif",  vjust = 1.5) +
facet_wrap(~ Accession)
ggplot(nitrate.data, aes(x=Accession, y=DryWeight_g, fill=Nlevel)) + geom_boxplot()
nitrate.data <- nitrate_data
ggplot(nitrate.data, aes(x=Accession, y=DryWeight_g, fill=Nlevel)) + geom_boxplot()
ggplot(nitrate.data, aes(x=Accession, y=DryWeight_g, fill=Nlevel)) + geom_boxplot() + stat_compare_means(label="p.signif")
